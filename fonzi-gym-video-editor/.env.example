# Copy this file to .env and fill it in. .env is git-ignored. Never paste tokens anywhere else.
# Facebook Page: Fonzi.stays.fit   |   Instagram: @fonzi.stays.fit

# Numeric ID of the Facebook Page
META_PAGE_ID=
# Long-lived PAGE access token with: pages_manage_posts, pages_read_engagement, pages_show_list,
# instagram_basic, instagram_content_publish
META_PAGE_ACCESS_TOKEN=
# Numeric ID of the Instagram professional account linked to the Page
META_IG_USER_ID=
# Graph API version (check developers.facebook.com/docs/graph-api/changelog for the current one)
META_GRAPH_VERSION=v24.0

# Video generator for multicam angles / B-roll (your own key, billed to you). Used by Seedance 2.5 and Kling
# through fal.ai, as set in config.yaml. Leave empty and the generator step stops and tells you.
FAL_KEY=

# Optional: Whisper model for captions (tiny.en, base.en, small.en, medium.en). Bigger = more accurate, slower.
# WHISPER_MODEL=small.en
